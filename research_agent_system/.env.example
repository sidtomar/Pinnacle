# ── Storage Backend ───────────────────────────────────────────────────────────
# sqlite      → local SQLite file, zero setup (demo / local dev)  ← DEFAULT
# databricks  → Azure Databricks Delta Lake (production)
# Migration:  just change this one line. Nothing else in the code changes.
STORE_BACKEND=sqlite

# SQLite file path (only used when STORE_BACKEND=sqlite)
SQLITE_DB_PATH=pinnacleiq_demo.db

# ── Admin endpoint guard ──────────────────────────────────────────────────────
# Protects POST /admin/upload-doctors (destructive full-DB overwrite).
# Leave BLANK for the zero-config demo (endpoint stays open, logs a warning).
# Set to a strong secret in any shared/production deployment — callers must then
# send a matching `X-Admin-Token` header.
ADMIN_UPLOAD_TOKEN=

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Recommended: "openrouter" — one key, switch between 100+ models freely
# Legacy options: "claude" (direct Anthropic) | "openai" (direct OpenAI)
LLM_PROVIDER=openrouter

# ── OpenRouter (https://openrouter.ai) ────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pick any model slug from https://openrouter.ai/models
# Anthropic:  anthropic/claude-sonnet-4-5 | anthropic/claude-opus-4 | anthropic/claude-haiku-3-5
# OpenAI:     openai/gpt-4o | openai/gpt-4o-mini | openai/o3-mini
# Google:     google/gemini-pro-1.5 | google/gemini-flash-1.5
# Meta:       meta-llama/llama-3.1-405b-instruct | meta-llama/llama-3.1-70b-instruct
# Mistral:    mistralai/mistral-large | mistralai/mixtral-8x7b-instruct
# DeepSeek:   deepseek/deepseek-r1 | deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Legacy Direct API Keys (only needed if LLM_PROVIDER=claude or openai) ─────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o

# ── Tavily Search ─────────────────────────────────────────────────────────────
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5

# ── Microsoft OneDrive (Azure App Registration) ───────────────────────────────
ONEDRIVE_CLIENT_ID=your_azure_app_client_id
ONEDRIVE_CLIENT_SECRET=your_azure_app_client_secret
ONEDRIVE_TENANT_ID=your_azure_tenant_id
ONEDRIVE_FOLDER_PATH=Research

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_RECIPIENTS=whatsapp:+91XXXXXXXXXX

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=research@yourdomain.com
EMAIL_FROM_NAME=Pinnacle Research Bot
EMAIL_RECIPIENTS=doctor@hospital.com

# ── Azure Databricks (Primary Data Store) ────────────────────────────────────
# Step 1: Go to your Databricks workspace → SQL Warehouses → pick one
# Step 2: Click warehouse → "Connection details" tab → copy hostname + HTTP path
# Step 3: Settings → Developer → Access tokens → Generate new token

# Server hostname — e.g. adb-1234567890123.1.azuredatabricks.net  (no https://)
DATABRICKS_HOST=your-workspace.azuredatabricks.net

# HTTP path — e.g. /sql/1.0/warehouses/abc1234def567890
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id

# Personal Access Token (PAT) or Service Principal token
DATABRICKS_TOKEN=your_databricks_token_here

# Unity Catalog location for PinnacleIQ tables
# Run in a Databricks notebook first:
#   CREATE CATALOG IF NOT EXISTS pinnacleiq;
#   CREATE SCHEMA IF NOT EXISTS pinnacleiq.medical_content;
DATABRICKS_CATALOG=pinnacleiq
DATABRICKS_SCHEMA=medical_content

# ── Pinnacle Portal API (optional — for direct portal POST during transition) ──
PINNACLE_API_URL=https://api.pinnacle.yourdomain.com/reports
PINNACLE_API_KEY=your_pinnacle_api_key_here

# ── Doctor Sync (Superman CRM via Databricks) ─────────────────────────────────
# Leave SUPERMAN_DOCTOR_TABLE blank to use JSON cache fallback (demo mode)
SUPERMAN_DOCTOR_TABLE=superman_crm.doctors.hcp_master
SUPERMAN_COL_ID=doctor_id
SUPERMAN_COL_NAME=full_name
SUPERMAN_COL_PHONE=mobile
SUPERMAN_COL_EMAIL=email
SUPERMAN_COL_SPECIALTY=specialty
SUPERMAN_COL_DIVISION=division
SUPERMAN_COL_TIER=tier
SUPERMAN_COL_HOSPITAL=hospital
SUPERMAN_COL_CITY=city
SUPERMAN_COL_INTERESTS=therapy_interests
SUPERMAN_COL_LAST_MOD=updated_at

# ── Daily Scheduler (IST) ─────────────────────────────────────────────────────
# Times are in Asia/Kolkata (IST) timezone
SYNC_HOUR=6
SYNC_MINUTE=30
CONTENT_HOUR=7
CONTENT_MINUTE=0

# ── Notifications ─────────────────────────────────────────────────────────────
# Used for email stubs — set real addresses to activate SendGrid email delivery
MA_TEAM_EMAIL=ma-team@mankind.com
BU_HEAD_EMAIL=bu-head@mankind.com

# ── Databricks Vector Search (MA Document Library) ───────────────────────────
# These power the semantic search tool used by Agent Alpha to retrieve relevant
# internal clinical documents, protocols, and real-world evidence reports.
#
# Step-by-step setup:
#   1. In your Databricks workspace: Compute → Vector Search → Create endpoint
#      (endpoint type: Standard)
#   2. Create the source Delta table by running ensure_schema() from ingest_docs.py
#      OR run the DDL in research_agent_system/ingestion/ingest_docs.py manually
#   3. Create the index: either call bootstrap_vector_search() from ingest_docs.py
#      OR use the Databricks UI (Catalog → Create index)
#   4. Ingest your documents: call ingest_folder("Research/", division="...", ...)
#   5. Set these env vars and restart the backend

# Vector Search endpoint name (created in Databricks UI → Vector Search)
DATABRICKS_VS_ENDPOINT_NAME=pinnacleiq_vs

# Fully-qualified index name (catalog.schema.index_name)
DATABRICKS_VS_INDEX_NAME=pinnacleiq.medical_content.document_chunks_index

# Delta source table that backs the index (catalog.schema.table_name)
# Must have delta.enableChangeDataFeed = true
DATABRICKS_VS_SOURCE_TABLE=pinnacleiq.medical_content.document_chunks

# Embedding model served by Databricks Model Serving (Foundation Model API)
# Options:
#   databricks-bge-large-en   — best quality for medical English text (recommended)
#   databricks-gte-large-en   — alternative high-quality English embeddings
#   databricks-e5-large-v2    — lighter / faster option
EMBEDDING_MODEL=databricks-bge-large-en

# Local document path for demo / fallback mode (optional)
# Defaults to <project_root>/Research/ if not set
# LOCAL_DOCS_PATH=/path/to/your/Research/folder
